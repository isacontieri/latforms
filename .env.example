# Copie para .env.local e preencha. Nunca commitar o .env.local.
# Supabase → painel do projeto latforms-dev

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<ref-do-projeto>.supabase.co
# Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project Settings → API Keys → Secret keys → criar/copiar (sb_secret_...). SÓ servidor.
SUPABASE_SECRET_KEY=

# App
APP_URL=http://localhost:3000
TOKEN_TTL_DIAS=15
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
# true = pede a data de nascimento antes de mostrar a ficha ao cliente (padrão: desligado)
EXIGIR_VERIFICACAO=false
